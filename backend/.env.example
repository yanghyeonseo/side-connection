# 곁에 API 환경변수. 모두 선택 사항이며 접두사 GYEOTE_ 를 붙입니다.
# 복지사업 데이터 디렉터리 (기본값: 저장소 루트의 data/)
GYEOTE_DATA_DIR=../data
# 브라우저 CORS 허용 출처 (JSON 배열)
GYEOTE_CORS_ORIGINS=["http://localhost:5173","https://yanghyeonseo.github.io"]
# 세션 보관 시간(분). 만료 후 답변은 자동 삭제됩니다.
GYEOTE_SESSION_TTL_MINUTES=1440
# 세션 맞춤 추천 시 반환할 최대 사업 수
GYEOTE_MATCH_LIMIT=12

# ── 외부 서비스 키 (저장소 루트 .env에 접두사 없이 둔다) ──
# OPENAI_KEY=sk-...                # AI 큐레이션·상담원 안내문. 없으면 규칙 기반 문구
# OPENAI_MODEL=gpt-5-mini
# GOV24_SERVICE_KEY=...            # [행정안전부] 대한민국 공공서비스(혜택) 정보
# WELFARE_INFO_SERVICE_KEY=...     # [한국사회보장정보원] 복지서비스정보
# WELFARE_CENTER_PHONE=129         # 전화 상담 번호 (기본 129 보건복지상담센터)
# WELFARE_CENTER_SMS_NUMBER=       # 문자 수신 번호 (선택)
