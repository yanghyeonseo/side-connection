# 루트 .env 로 복사해서 사용합니다. 서버(백엔드)용 비밀키만 둡니다.
# 프론트엔드(Vite) 변수는 frontend/.env.example 을 참고하세요. 빌드는 이 파일을 읽지 않습니다.

# ── AI ───────────────────────────────────────────────────────────────
# OpenAI API 키 (추천 큐레이션·상담원 안내문 생성). 없으면 규칙 기반 문구로 동작
OPENAI_KEY=sk-proj-...
# 사용할 모델 (미설정 시 gpt-5-mini)
OPENAI_MODEL=gpt-5-mini

# ── 공공데이터포털 (data.go.kr) 인증키 ───────────────────────────────
# [행정안전부] 대한민국 공공서비스(혜택) 정보 — api.odcloud.kr/api/gov24/v3
GOV24_SERVICE_KEY=
# [한국사회보장정보원] 복지서비스정보 — api.odcloud.kr/api/15083323/v1
WELFARE_INFO_SERVICE_KEY=

# ── 상담 연결(전화·문자) ─────────────────────────────────────────────
# 전화 상담 번호 (기본 129 = 보건복지상담센터)
WELFARE_CENTER_PHONE=129
# 문자 수신 번호 (비우면 문자 버튼 숨김)
WELFARE_CENTER_SMS_NUMBER=

# ── 백엔드 동작 설정 (전체 목록은 backend/.env.example) ──────────────
# 공공데이터 자동 갱신: false면 주기 갱신 없이 기동 시 캐시가 낡았을 때만 1회 수집
GYEOTIEUM_OPEN_DATA_AUTO_REFRESH=true
